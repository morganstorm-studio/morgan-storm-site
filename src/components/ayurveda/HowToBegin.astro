---
import { howToBegin } from "../../data/pages/ayurveda";
---

<section class="bg-linen">
  <div class="container-content py-16 md:py-24">
    <h2 class="text-center font-display text-3xl text-deep-ocean md:text-4xl">{howToBegin.heading}</h2>

    <div class="mx-auto mt-14 grid max-w-4xl gap-10 sm:grid-cols-3">
      {
        howToBegin.steps.map((step) => (
          <div class="relative mt-4 rounded-2xl bg-teal-mist/30 px-6 pt-9 pb-7 text-center">
            <span class="absolute -top-5 left-1/2 flex h-9 w-9 -translate-x-1/2 items-center justify-center rounded-full border border-warm-sand bg-linen font-display text-base text-deep-ocean">
              {step.number}
            </span>
            <h3 class="font-display text-lg text-deep-ocean">{step.title}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-deep-ocean/80">{step.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex justify-center">
      <a
        href={howToBegin.cta.href}
        class="inline-flex items-center gap-2 rounded-full bg-vishuddha-teal px-7 py-3.5 font-body text-base text-linen transition-colors hover:bg-deep-ocean"
      >
        {howToBegin.cta.label}
      </a>
    </div>
  </div>
</section>
