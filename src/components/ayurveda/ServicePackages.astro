---
import { Image } from "astro:assets";
import leafAccent from "../../assets/ayurveda-wireframe/leaves-15.png";
import { servicePackages } from "../../data/pages/ayurveda";
---

<section class="relative overflow-hidden bg-linen">
  <Image
    src={leafAccent}
    alt=""
    widths={[400, 600, 800]}
    sizes="600px"
    loading="lazy"
    class="pointer-events-none absolute bottom-[-90px] left-[-140px] z-0 hidden w-[clamp(420px,36vw,600px)] -translate-y-[150%] scale-x-[-1] rotate-90 opacity-100 lg:block"
    aria-hidden="true"
  />
  <Image
    src={leafAccent}
    alt=""
    widths={[400, 600, 800]}
    sizes="600px"
    loading="lazy"
    class="pointer-events-none absolute right-[-140px] bottom-[-90px] z-0 hidden w-[clamp(420px,36vw,600px)] -translate-y-[65%] -rotate-90 opacity-100 lg:block"
    aria-hidden="true"
  />

  <div class="container-content relative z-10 py-20 md:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-display-md text-deep-ocean">{servicePackages.heading}</h2>
      <p class="mt-5 font-body text-lg text-deep-ocean/80">{servicePackages.supporting}</p>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-3 md:items-stretch">
      {
        servicePackages.packages.map((pkg) => (
          <div
            class={`flex flex-col items-center rounded-2xl border-t-4 border-warm-sand p-10 text-center shadow-md ${
              pkg.recommended
                ? "order-first bg-deep-ocean text-linen shadow-xl md:order-none md:scale-105"
                : "bg-teal-mist/40 text-deep-ocean"
            }`}
          >
            {pkg.recommended && (
              <span class="mb-4 rounded-full bg-warm-sand px-3 py-1 text-[10px] tracking-widest text-deep-ocean uppercase">
                Recommended
              </span>
            )}
            <h3 class="font-display text-xl">{pkg.tagline}</h3>
            <p class={`mt-3 font-body text-sm italic ${pkg.recommended ? "text-linen/90" : "text-deep-ocean/80"}`}>{pkg.bestFor}</p>
            <p class={`mt-5 font-body text-sm leading-relaxed ${pkg.recommended ? "text-linen/90" : "text-deep-ocean/85"}`}>
              {pkg.description}
            </p>
            <details class={`mt-6 w-full group ${pkg.recommended ? "text-linen" : "text-deep-ocean"}`}>
              <summary class={`flex cursor-pointer list-none items-center justify-center gap-2 font-body text-sm ${pkg.recommended ? "text-linen" : "text-deep-ocean"} marker:content-none [&::-webkit-details-marker]:hidden`}>
                <span>What It Includes</span>
                <span class={`transition-transform duration-200 group-open:rotate-45 ${pkg.recommended ? "text-warm-sand" : "text-vishuddha-teal"}`} aria-hidden="true">+</span>
              </summary>
              <ul class={`mt-4 space-y-3 font-body text-sm leading-relaxed ${pkg.recommended ? "text-linen/90" : "text-deep-ocean/85"}`}>
                {pkg.features.map((feature) => (
                  <li class="flex gap-2 justify-center">
                    <span aria-hidden="true">·</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </details>
            <p class="mt-6 font-display text-xl">{pkg.price}</p>
            {pkg.priceNote && (
              <p class={`mt-0.5 text-sm line-through ${pkg.recommended ? "text-linen/70" : "text-deep-ocean/70"}`}>{pkg.priceNote}</p>
            )}
            {pkg.minimumTerm && (
              <p class={`mt-0.5 text-sm ${pkg.recommended ? "text-linen/70" : "text-deep-ocean/70"}`}>{pkg.minimumTerm}</p>
            )}
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-16 max-w-xl text-center">
      <p class="font-body text-base text-deep-ocean/80">{servicePackages.sharedCta.supporting}</p>
      <div class="mt-6 flex justify-center">
        <a
          href={servicePackages.sharedCta.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-warm-sand px-8 py-4 font-body text-base text-deep-ocean transition-colors hover:bg-deep-ocean hover:text-linen"
        >
          {servicePackages.sharedCta.cta.label}
        </a>
      </div>
    </div>

    <div class="mx-auto mt-20 flex max-w-3xl flex-col items-start gap-7 rounded-2xl bg-nadi-flow p-10 text-linen md:flex-row md:items-center">
      <div class="flex-1">
        <p class="font-accent text-xs uppercase tracking-wide text-linen/80">{servicePackages.mealCompanion.eyebrow}</p>
        <h3 class="mt-3 font-display text-lg">{servicePackages.mealCompanion.heading}</h3>
        <p class="mt-3 font-body text-sm leading-relaxed text-linen/90">{servicePackages.mealCompanion.description}</p>
      </div>
      <div class="flex flex-col gap-3">
        {
          servicePackages.mealCompanion.examples.map((example) => (
            <div class="rounded-xl border border-linen/30 bg-linen/10 px-5 py-3 font-body text-sm text-linen">
              {example}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
