---
import { Image } from "astro:assets";
import leafAccent from "../../assets/ayurveda-wireframe/leaves-15.png";
import { servicePackages } from "../../data/pages/ayurveda";
---

<section class="relative overflow-hidden bg-linen">
  <Image
    src={leafAccent}
    alt=""
    widths={[400, 600]}
    sizes="420px"
    loading="lazy"
    class="pointer-events-none absolute -bottom-16 -left-16 z-0 hidden w-96 -scale-x-100 opacity-15 lg:block"
    aria-hidden="true"
  />
  <Image
    src={leafAccent}
    alt=""
    widths={[400, 600]}
    sizes="420px"
    loading="lazy"
    class="pointer-events-none absolute -right-16 -bottom-16 z-0 hidden w-96 rotate-180 opacity-15 lg:block"
    aria-hidden="true"
  />

  <div class="container-content relative py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-display-md text-deep-ocean">{servicePackages.heading}</h2>
      <p class="mt-4 font-body text-lg text-deep-ocean/80">{servicePackages.supporting}</p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3 md:items-stretch">
      {
        servicePackages.packages.map((pkg) => (
          <div
            class={`flex flex-col rounded-2xl border-t-4 border-warm-sand p-9 shadow-md ${
              pkg.recommended
                ? "bg-deep-ocean text-linen shadow-xl md:scale-105"
                : "bg-white text-deep-ocean"
            }`}
          >
            {pkg.recommended && (
              <span class="mb-4 w-fit rounded-full bg-warm-sand px-3 py-1 text-[10px] tracking-widest text-deep-ocean uppercase">
                Recommended
              </span>
            )}
            <p class={`font-accent text-sm uppercase tracking-wide ${pkg.recommended ? "text-warm-sand" : "text-vishuddha-teal"}`}>
              {pkg.eyebrow}
            </p>
            <p class={`mt-3 font-body text-sm italic ${pkg.recommended ? "text-linen/90" : "text-deep-ocean/80"}`}>{pkg.tagline}</p>
            <h3 class="mt-4 font-display text-xl">{pkg.title}</h3>
            <p class="mt-1 font-display text-xl">{pkg.price}</p>
            {pkg.priceNote && (
              <p class={`mt-0.5 text-sm ${pkg.recommended ? "text-linen/70 line-through" : "text-deep-ocean/70"}`}>{pkg.priceNote}</p>
            )}
            <p class={`mt-4 font-body text-sm leading-relaxed ${pkg.recommended ? "text-linen/90" : "text-deep-ocean/85"}`}>
              {pkg.description}
            </p>
            <ul class={`mt-5 space-y-2 font-body text-sm leading-relaxed ${pkg.recommended ? "text-linen/90" : "text-deep-ocean/85"}`}>
              {pkg.features.map((feature) => (
                <li class="flex gap-2">
                  <span aria-hidden="true">·</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <p class={`mt-5 font-body text-xs ${pkg.recommended ? "text-linen/70" : "text-deep-ocean/60"}`}>{pkg.bestFor}</p>
            <a
              href={pkg.cta.href}
              class={`mt-auto flex items-center justify-center gap-2 rounded-full px-6 py-3.5 font-body text-sm transition-colors ${
                pkg.recommended
                  ? "bg-vishuddha-teal text-linen hover:bg-warm-sand hover:text-deep-ocean"
                  : "bg-deep-ocean text-linen hover:bg-vishuddha-teal"
              }`}
            >
              {pkg.cta.label}
            </a>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-14 flex max-w-3xl flex-col items-start gap-6 rounded-2xl bg-nadi-flow p-9 text-linen md:flex-row md:items-center">
      <div class="flex-1">
        <p class="font-accent text-xs uppercase tracking-wide text-linen/80">{servicePackages.mealCompanion.eyebrow}</p>
        <h3 class="mt-2 font-display text-lg">{servicePackages.mealCompanion.heading}</h3>
        <p class="mt-2 font-body text-sm leading-relaxed text-linen/90">{servicePackages.mealCompanion.description}</p>
      </div>
      <div class="rounded-xl border border-linen/30 bg-linen/10 px-5 py-3 font-body text-sm whitespace-nowrap text-linen">
        {servicePackages.mealCompanion.example}
      </div>
    </div>
  </div>
</section>
