---
import { ayurvedaFAQ } from "../../data/pages/ayurveda";
---

<section class="bg-linen">
  <div class="container-content py-16 md:py-24">
    <h2 class="text-center font-display text-3xl text-deep-ocean md:text-4xl">{ayurvedaFAQ.heading}</h2>

    <div class="mx-auto mt-12 max-w-3xl divide-y divide-deep-ocean/10 border-t border-b border-deep-ocean/10">
      {
        ayurvedaFAQ.items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-body text-base text-deep-ocean marker:content-none [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <span class="shrink-0 font-display text-lg text-warm-sand transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 max-w-2xl font-body text-sm leading-relaxed text-deep-ocean/80">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
