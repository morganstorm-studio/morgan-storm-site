---
import { Image } from "astro:assets";
import portraitImage from "../../assets/ayurveda-wireframe/accessible-intro-portrait.jpg";
import edgeImage from "../../assets/ayurveda-wireframe/accessible-intro-edge.jpg";
import { accessibleIntro } from "../../data/pages/ayurveda";
---

<section class="relative overflow-hidden bg-linen">
  <div class="absolute inset-y-0 right-0 hidden w-[26%] lg:block" aria-hidden="true">
    <Image
      src={edgeImage}
      alt=""
      widths={[400, 600]}
      sizes="26vw"
      loading="lazy"
      class="h-full w-full object-cover"
      style="object-position: 70% 35%"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-deep-ocean/55 to-deep-ocean/75"></div>
  </div>

  <div class="container-content relative py-16 lg:pr-[28%] md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-8">
      <div>
        <p class="font-accent text-sm uppercase tracking-widest text-vishuddha-teal">{accessibleIntro.eyebrow}</p>
        <div class="mt-4 h-px w-12 bg-warm-sand"></div>
        <h2 class="mt-6 font-display text-display-md text-deep-ocean">{accessibleIntro.heading}</h2>
        {
          accessibleIntro.paragraphs.map((paragraph) => (
            <p class="mt-5 max-w-lg font-body text-base leading-relaxed text-deep-ocean/85">{paragraph}</p>
          ))
        }
      </div>

      <div class="flex justify-center lg:justify-end">
        <Image
          src={portraitImage}
          alt="Morgan Storm giving an Ayurvedic bodywork treatment"
          widths={[300, 500, 700]}
          sizes="(min-width: 1024px) 320px, 70vw"
          loading="lazy"
          class="aspect-3/4 w-72 border-4 border-warm-sand object-cover shadow-lg md:w-80"
        />
      </div>
    </div>
  </div>
</section>
