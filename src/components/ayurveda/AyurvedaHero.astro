---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/hero_opt1.jpg";
import { ayurvedaHero } from "../../data/pages/ayurveda";
---

<section class="relative overflow-hidden bg-deep-ocean">
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
      style="object-position: 25% 42%"
    />
  </div>
  <!-- Subject sits on the left of the frame; darken the right side so the
       text column reads clearly against open sky/foliage. -->
  <div class="absolute inset-0 bg-gradient-to-r from-deep-ocean/10 via-deep-ocean/45 to-deep-ocean/75" aria-hidden="true"></div>

  <div class="container-content relative py-32 md:py-40 lg:py-48">
    <div class="mx-auto max-w-xl text-center md:ml-auto md:mr-0 md:max-w-md md:text-left">
      <p class="font-accent text-sm uppercase tracking-widest text-linen/90">{ayurvedaHero.eyebrow}</p>
      <h1 class="mt-4 font-display text-display-lg leading-[1.15] text-linen">
        {ayurvedaHero.headline}
      </h1>
      <p class="mt-5 font-body text-base text-linen/85 md:text-lg">
        {ayurvedaHero.supporting}
      </p>
      <div class="mt-8 flex justify-center md:justify-start">
        <a
          href={ayurvedaHero.cta.href}
          class="inline-flex items-center gap-2 rounded-full bg-vishuddha-teal px-7 py-3.5 font-body text-base text-linen transition-colors hover:bg-deep-ocean"
        >
          {ayurvedaHero.cta.label}
        </a>
      </div>
    </div>
  </div>
</section>
