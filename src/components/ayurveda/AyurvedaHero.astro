---
import { Image } from "astro:assets";
import heroImage from "../../assets/ayurveda-wireframe/hero_opt1.jpg";
import { ayurvedaHero } from "../../data/pages/ayurveda";
---

<section class="relative overflow-hidden bg-deep-ocean">
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
      style="object-position: 25% 42%"
    />
  </div>
  <!-- Overlay is localized behind the text column: transparent to the left so
       Morgan and the photo stay clear, fading in behind the copy on the right. -->
  <div
    class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-deep-ocean/65 to-transparent md:inset-y-0 md:left-auto md:h-auto md:w-[70%] md:bg-gradient-to-r md:from-transparent md:via-deep-ocean/35 md:to-deep-ocean/75"
    aria-hidden="true"
  ></div>

  <div class="container-content relative flex min-h-[105vh] flex-col justify-end py-12 md:block md:min-h-0 md:py-44 lg:py-52">
    <div class="mx-auto max-w-xl text-center md:mr-0 md:ml-auto md:w-1/2 md:max-w-none md:text-left lg:w-[52%]">
      <p class="font-accent text-sm uppercase tracking-widest text-linen/90">{ayurvedaHero.eyebrow}</p>
      <h1 class="mt-5 font-display text-display-lg text-linen">
        {ayurvedaHero.headline}
      </h1>
      {
        ayurvedaHero.supporting.map((paragraph) => (
          <p class="mt-5 font-body text-base text-linen/85 md:text-lg">{paragraph}</p>
        ))
      }
      <div class="mt-10 flex justify-center md:justify-start">
        <a
          href={ayurvedaHero.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-warm-sand px-8 py-4 font-body text-base text-deep-ocean transition-colors hover:bg-deep-ocean hover:text-linen"
        >
          {ayurvedaHero.cta.label}
        </a>
      </div>
      <p class="mt-4 font-body text-sm text-linen/70">{ayurvedaHero.note}</p>
    </div>
  </div>
</section>
