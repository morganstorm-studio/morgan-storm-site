---
import { workingMethod } from "../../data/pages/home";
---

<section class="bg-deep-ocean">
  <div class="container-content py-16 md:py-24">
    <p class="font-accent text-sm uppercase tracking-widest text-warm-sand">The Method</p>
    <ol class="mt-6 border-t border-b border-linen/20 divide-y divide-linen/20">
      {
        workingMethod.steps.map((step, index) => (
          <li
            class={`flex flex-col gap-3 py-8 md:flex-row md:items-baseline md:gap-10 ${
              index % 2 === 1 ? "md:pl-16" : ""
            }`}
          >
            <span class="font-display text-5xl text-teal-mist md:text-6xl" aria-hidden="true">
              {step.number}
            </span>
            <div class="max-w-xl">
              <h3 class="font-display text-2xl text-linen md:text-3xl">{step.title}</h3>
              <p class="mt-2 font-body text-linen/75">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
