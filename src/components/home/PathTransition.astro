---
import { pathForward } from "../../data/pages/home";
---

<section class="relative overflow-hidden bg-warm-sand/40 py-10 md:py-14">
  <p
    class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 text-center font-display text-4xl text-deep-ocean/10 uppercase select-none sm:text-6xl md:text-7xl"
    aria-hidden="true"
  >
    Building It Is The Work
  </p>
  <div class="container-content relative z-10">
    <p class="mx-auto max-w-lg text-center font-accent text-xl text-deep-ocean md:text-2xl">
      {pathForward.caption}
    </p>
  </div>
</section>
