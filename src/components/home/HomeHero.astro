---
import { Image } from "astro:assets";
import heroBackground from "../../assets/Images/hero-background.png";
import portraitImage from "../../assets/Images/morgan-hero-portrait.png";
import { hero } from "../../data/pages/home";
import GraphicPlaceholder from "../ui/GraphicPlaceholder.astro";
---

<section class="relative overflow-hidden bg-deep-ocean">
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={heroBackground}
      alt=""
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>
  <!-- Restrained, directional overlay: darker behind the text column (left),
       fading to transparent toward the portrait (right) — not a flat wash. -->
  <div class="absolute inset-0 bg-gradient-to-r from-deep-ocean/55 via-deep-ocean/15 to-transparent" aria-hidden="true"></div>

  <div class="container-content relative py-20 md:py-28 lg:py-32">
    <div class="grid items-center gap-12 md:grid-cols-12 md:gap-8">
      <div class="text-center md:col-span-7 md:text-left">
        <p class="font-accent text-sm uppercase tracking-widest text-linen/90">{hero.eyebrow}</p>

        <h1 class="mt-4 font-display text-display-lg text-linen">
          {hero.headline}
        </h1>

        <div class="mt-4 flex justify-center md:justify-start">
          <GraphicPlaceholder variant="divider" class="h-4 w-4 text-warm-sand" />
        </div>

        <p class="mt-4 font-body text-lg text-linen/85">
          {hero.supporting}
        </p>

        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center md:items-start md:justify-start">
          {
            hero.ctas.map((cta) => (
              <a
                href={cta.href}
                class={`inline-flex items-center gap-2 rounded-full px-7 py-3.5 font-body text-base transition-colors ${
                  cta.variant === "primary"
                    ? "bg-vishuddha-teal text-linen hover:bg-deep-ocean"
                    : "bg-linen text-deep-ocean hover:bg-warm-sand"
                }`}
              >
                <GraphicPlaceholder variant="button" class="h-4 w-4" />
                {cta.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="relative mx-auto h-64 w-64 overflow-hidden rounded-full border-2 border-vishuddha-teal shadow-sm md:h-80 md:w-80">
          <Image
            src={portraitImage}
            alt="Morgan Storm, Ayurvedic Wellness Counselor and digital strategist"
            widths={[300, 500, 700]}
            sizes="(min-width: 768px) 320px, 256px"
            loading="eager"
            class="h-full w-full object-cover object-center"
          />
        </div>
      </div>
    </div>
  </div>
</section>
