---
import { primaryNav, logos } from "../../data/site";
import Button from "../ui/Button.astro";
---

<header class="sticky top-0 z-50 border-b border-teal-mist bg-linen/95 backdrop-blur">
  <div class="container-content flex items-center justify-between py-4">
    <a href="/" class="flex items-center">
      <img
        src={logos.primaryLockup}
        alt="Morgan Storm — Ayurvedic Wellness Counselor"
        class="hidden h-9 w-auto md:block"
      />
      <span class="font-display text-2xl text-deep-ocean md:hidden">Morgan Storm</span>
    </a>

    <nav aria-label="Primary">
      <ul class="hidden items-center gap-6 md:flex">
        {
          primaryNav.map((link) => (
            <li>
              <a href={link.href} class="font-body text-sm text-deep-ocean hover:text-vishuddha-teal">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden md:block">
      <Button href="/contact" label="Get in Touch" variant="primary" />
    </div>

    <button
      type="button"
      class="font-body text-sm text-deep-ocean md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="nav-toggle"
    >
      <span class="sr-only">Toggle menu</span>
      <span aria-hidden="true">Menu</span>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-teal-mist px-6 py-4 md:hidden">
    <ul class="flex flex-col gap-4">
      {
        primaryNav.map((link) => (
          <li>
            <a href={link.href} class="font-body text-deep-ocean">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("mobile-nav");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    nav?.classList.add("hidden");
  };

  const openMenu = () => {
    toggle?.setAttribute("aria-expanded", "true");
    nav?.classList.remove("hidden");
  };

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    if (expanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const expanded = toggle?.getAttribute("aria-expanded") === "true";
    if (!expanded) return;
    closeMenu();
    toggle?.focus();
  });
</script>
