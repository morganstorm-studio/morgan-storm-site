---
import { primaryNav, logos } from "../../data/site";

// Fixed/floating header: intentionally taken out of normal document flow so
// the homepage hero photo can extend behind it uninterrupted. Interior
// pages compensate with extra top padding in PageHero.astro.
---

<header class="fixed inset-x-0 top-0 z-50 px-[4vw] pt-5 md:px-[5vw] md:pt-6">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-linen/30 bg-deep-ocean/35 px-5 py-2.5 backdrop-blur-md md:px-6 md:py-3">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Morgan Storm — Home">
      <img src={logos.dhiSanghaMark} alt="" class="h-6 w-6 md:h-7 md:w-7" />
      <span class="font-display text-xl text-linen md:text-2xl">Morgan Storm</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          primaryNav.map((link) =>
            link.children && link.children.length > 0 ? (
              <li class="relative" data-nav-dropdown>
                <div class="flex items-center gap-1">
                  <a href={link.href} class="font-body text-sm text-linen hover:text-warm-sand">
                    {link.label}
                  </a>
                  <button
                    type="button"
                    class="flex h-6 w-6 items-center justify-center rounded text-linen"
                    aria-expanded="false"
                    aria-label={`Show ${link.label} submenu`}
                    data-nav-toggle
                  >
                    <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                      <path
                        d="M1 1l4 4 4-4"
                        stroke="currentColor"
                        stroke-width="1.5"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                </div>
                <ul
                  class="absolute top-full left-0 z-50 mt-2 hidden min-w-[9rem] rounded-lg border border-teal-mist bg-linen/95 py-1.5 backdrop-blur-sm"
                  data-nav-submenu
                >
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-4 py-2 font-body text-sm text-deep-ocean hover:bg-teal-mist/40 hover:text-vishuddha-teal"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={link.href} class="font-body text-sm text-linen hover:text-warm-sand">
                  {link.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a
      href="/contact"
      class="hidden shrink-0 rounded-full border border-linen/50 px-5 py-2 font-body text-sm text-linen transition-colors hover:border-vishuddha-teal hover:bg-vishuddha-teal md:inline-flex md:items-center"
    >
      Get in Touch
    </a>

    <button
      type="button"
      class="flex min-h-11 min-w-11 items-center justify-center rounded-full font-body text-sm text-linen md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="nav-toggle"
    >
      <span class="sr-only">Toggle menu</span>
      <span aria-hidden="true">Menu</span>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="mx-auto mt-3 hidden max-w-6xl rounded-2xl border border-teal-mist bg-linen py-3 shadow-md md:hidden"
  >
    <ul class="flex flex-col px-2">
      {
        primaryNav.map((link) => (
          <li>
            <a href={link.href} class="block min-h-11 rounded-lg px-4 py-3 font-body text-deep-ocean">
              {link.label}
            </a>
            {link.children && link.children.length > 0 && (
              <ul class="ml-4 flex flex-col border-l border-teal-mist pl-4">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} class="block min-h-11 py-2 font-body text-sm text-deep-ocean/80">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      <li class="mt-2 px-4 pb-1">
        <a
          href="/contact"
          class="block min-h-11 rounded-full bg-deep-ocean px-5 py-3 text-center font-body text-sm text-linen"
        >
          Get in Touch
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("mobile-nav");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    nav?.classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
  };

  const openMenu = () => {
    toggle?.setAttribute("aria-expanded", "true");
    nav?.classList.remove("hidden");
    document.body.classList.add("overflow-hidden");
  };

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    if (expanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const expanded = toggle?.getAttribute("aria-expanded") === "true";
    if (!expanded) return;
    closeMenu();
    toggle?.focus();
  });

  document.addEventListener("click", (event) => {
    const expanded = toggle?.getAttribute("aria-expanded") === "true";
    if (!expanded) return;
    const target = event.target;
    if (toggle?.contains(target) || nav?.contains(target)) return;
    closeMenu();
  });

  // Desktop dropdown submenus (Web & Strategy → Portfolio, About → Résumé)
  const dropdowns = Array.from(document.querySelectorAll("[data-nav-dropdown]"));

  const openDropdown = (el) => {
    el.querySelector("[data-nav-toggle]")?.setAttribute("aria-expanded", "true");
    el.querySelector("[data-nav-submenu]")?.classList.remove("hidden");
  };

  const closeDropdown = (el) => {
    el.querySelector("[data-nav-toggle]")?.setAttribute("aria-expanded", "false");
    el.querySelector("[data-nav-submenu]")?.classList.add("hidden");
  };

  const closeAllDropdowns = () => dropdowns.forEach(closeDropdown);

  dropdowns.forEach((el) => {
    el.addEventListener("mouseenter", () => openDropdown(el));
    el.addEventListener("mouseleave", () => closeDropdown(el));

    el.addEventListener("focusin", () => openDropdown(el));
    el.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (!next || !el.contains(next)) {
        closeDropdown(el);
      }
    });

    el.querySelector("[data-nav-toggle]")?.addEventListener("click", (event) => {
      event.preventDefault();
      const isOpen = el.querySelector("[data-nav-toggle]")?.getAttribute("aria-expanded") === "true";
      closeAllDropdowns();
      if (!isOpen) openDropdown(el);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const active = document.activeElement;
    dropdowns.forEach((el) => {
      if (el.contains(active)) {
        closeDropdown(el);
        el.querySelector("a")?.focus();
      } else {
        closeDropdown(el);
      }
    });
  });

  document.addEventListener("click", (event) => {
    dropdowns.forEach((el) => {
      if (!el.contains(event.target)) closeDropdown(el);
    });
  });
</script>
