---
interface Props {
  eyebrow?: string;
  heading: string;
  supporting?: string;
}

const { eyebrow, heading, supporting } = Astro.props;
---

<div class="container-content pt-28 pb-16 text-center md:pt-36 md:pb-24">
  {eyebrow && <p class="font-accent text-sm uppercase tracking-widest text-vishuddha-teal">{eyebrow}</p>}
  <h1 class="mt-4 font-display text-display-md text-deep-ocean md:text-display-lg">{heading}</h1>
  {supporting && <p class="mx-auto mt-4 max-w-2xl font-body text-lg text-deep-ocean/80">{supporting}</p>}
</div>
