---
import type { PlaceholderProject } from "../../data/portfolio-placeholder";

interface Props {
  project: PlaceholderProject;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<div class="flex flex-col gap-4 py-8 md:flex-row md:items-baseline md:gap-10">
  <span class="font-display text-4xl text-warm-sand md:text-5xl" aria-hidden="true">{number}</span>
  <div class="flex flex-1 flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
    <div>
      <p class="font-accent text-xs uppercase tracking-widest text-vishuddha-teal">{project.category}</p>
      <h3 class="mt-1 font-display text-2xl text-deep-ocean">{project.name}</h3>
      <p class="mt-1 font-body text-sm text-deep-ocean/70">{project.description}</p>
    </div>
    <p class="whitespace-nowrap font-body text-xs uppercase tracking-wide text-deep-ocean/40">
      Development placeholder
    </p>
  </div>
</div>
