---
import "@fontsource-variable/jost/wght.css";
import "../styles/global.css";
import SEO from "../components/seo/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { logos } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
}

const { title, description, image, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={logos.dhiSanghaMark} />
    <SEO title={title} description={description} image={image} canonicalPath={canonicalPath} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
